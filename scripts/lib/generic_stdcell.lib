/*
 * generic_stdcell.lib
 *
 * A small, vendor-independent Liberty library used purely as a *reference*
 * technology for this portfolio. It gives Yosys/ABC something to map onto and
 * OpenSTA something to time, so that every IP gets a consistent, reproducible
 * area and timing report without depending on any FPGA vendor primitive or on
 * a foundry PDK that cannot be redistributed.
 *
 * The numbers are representative of a generic ~45 nm low-power process. They
 * are NOT silicon-accurate and must never be used for signoff. Their purpose
 * is relative comparison: does a change make an IP bigger or slower?
 *
 * Units: time ns, capacitance pF, voltage V, resistance kOhm, power pW.
 *
 * Copyright (c) 2026 SoC IP Portfolio Contributors
 * SPDX-License-Identifier: Apache-2.0
 */
library (generic_stdcell) {

  technology (cmos);
  delay_model                     : table_lookup;
  in_place_swap_mode              : match_footprint;

  time_unit                       : "1ns";
  voltage_unit                    : "1V";
  current_unit                    : "1mA";
  pulling_resistance_unit         : "1kohm";
  leakage_power_unit              : "1pW";
  capacitive_load_unit            (1, pf);

  nom_process                     : 1.0;
  nom_temperature                 : 25.0;
  nom_voltage                     : 1.10;

  default_cell_leakage_power      : 0.0;
  default_fanout_load             : 1.0;
  default_inout_pin_cap           : 0.0015;
  default_input_pin_cap           : 0.0015;
  default_output_pin_cap          : 0.0;
  default_max_transition          : 1.0;

  slew_lower_threshold_pct_fall   : 20.0;
  slew_upper_threshold_pct_fall   : 80.0;
  slew_lower_threshold_pct_rise   : 20.0;
  slew_upper_threshold_pct_rise   : 80.0;
  input_threshold_pct_fall        : 50.0;
  input_threshold_pct_rise        : 50.0;
  output_threshold_pct_fall       : 50.0;
  output_threshold_pct_rise       : 50.0;
  slew_derate_from_library        : 1.0;

  operating_conditions (typical) {
    process     : 1.0;
    temperature : 25.0;
    voltage     : 1.10;
    tree_type   : balanced_tree;
  }
  default_operating_conditions : typical;

  wire_load ("wl_generic") {
    resistance   : 0.0002;
    capacitance  : 0.00015;
    area         : 0.05;
    slope        : 1.0;
    fanout_length (1, 2.6);
    fanout_length (2, 5.2);
    fanout_length (4, 10.4);
    fanout_length (8, 20.8);
    fanout_length (16, 41.6);
  }
  default_wire_load       : "wl_generic";
  default_wire_load_mode  : top;

  /* index_1 = input transition (ns), index_2 = output load (pF) */
  lu_table_template (delay_3x3) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.010, 0.100, 0.500");
    index_2 ("0.001, 0.020, 0.100");
  }
  lu_table_template (slew_3x3) {
    variable_1 : input_net_transition;
    variable_2 : total_output_net_capacitance;
    index_1 ("0.010, 0.100, 0.500");
    index_2 ("0.001, 0.020, 0.100");
  }
  lu_table_template (constraint_3x3) {
    variable_1 : related_pin_transition;
    variable_2 : constrained_pin_transition;
    index_1 ("0.010, 0.100, 0.500");
    index_2 ("0.010, 0.100, 0.500");
  }

  /*-------------------------------------------------------------------------
   * Combinational cells
   *-----------------------------------------------------------------------*/

  cell (INVX1) {
    area : 0.80;
    cell_leakage_power : 12.0;
    pin (A) { direction : input;  capacitance : 0.0015; }
    pin (Y) {
      direction : output;
      function  : "!A";
      max_capacitance : 0.100;
      timing () {
        related_pin : "A";
        timing_sense : negative_unate;
        cell_rise  (delay_3x3) { values ("0.014, 0.048, 0.190", "0.020, 0.055, 0.198", "0.045, 0.082, 0.228"); }
        rise_transition (slew_3x3) { values ("0.012, 0.060, 0.270", "0.016, 0.064, 0.275", "0.038, 0.088, 0.300"); }
        cell_fall  (delay_3x3) { values ("0.012, 0.042, 0.168", "0.018, 0.049, 0.176", "0.040, 0.073, 0.202"); }
        fall_transition (slew_3x3) { values ("0.010, 0.052, 0.238", "0.014, 0.056, 0.243", "0.033, 0.077, 0.265"); }
      }
    }
  }

